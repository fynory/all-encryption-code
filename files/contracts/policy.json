    "retire": {
      "$note": "The owner's figures of 2026-10-27 for retiring the old relay: every one of the last 30 complete UTC days has the nodes up at least 99.5 percent (_permille is thousandths: 995 is 99.5 percent, because nothing in this file is a fraction) and authorize failures at most 1 percent, and at least 95 percent of the eligible computers that enrolled have migrated. Even then the relay is retired only on the owner's explicit order.",
      "min_days_since_ready": 14,
      "sustain_days": 30,
      "node_availability_permille_min": 995,
      "authorize_failure_pct_max": 1,
