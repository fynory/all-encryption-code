{
  "$comment": "ALL 2.0 policy table: the ONE place where a number, a window or a limit of the end-to-end path is written down (plan section 0 and 7.1). The tunnel node (Go), the control plane (TypeScript) and the device (Python) read it; nobody copies a value into code (the contract generator lint fails the suite when one does). Units are in the key suffix: _s seconds, _bytes, _days, _pct percent. Keys listed in `provisional` are the plan's initial values: they are retuned after G0 and G1 and ONLY here.",
  "version": 1,
  "provisional": [
    "timing.stream_idle_s",
    "timing.stream_max_age_s",
    "timing.ping_interval_s",
    "timing.dead_peer_s",
    "node_limits.per_ip_concurrent",
    "node_limits.per_ip_new_per_s",
    "node_limits.label_streams_max",
    "node_limits.label_anon_slice",
    "node_limits.label_hint_slice",
    "node_limits.global_streams_max",
    "node_limits.openai_reserved_pct",
    "node_limits.openai_per_ip_factor",
    "node_limits.device_per_ip_factor",
    "node_limits.ip_table_max",
    "node_limits.unknown_sni_per_ip",
    "node_limits.unknown_sni_window_s",
    "node_limits.unknown_sni_ban_s",
    "node_limits.label_new_per_s",
    "node_limits.label_new_burst",
    "node_limits.hint_addresses_per_label",
    "terminator.endpoint_budgets",
    "terminator.max_streams",
    "budget.borrow_from",
    "budget.defer_jitter_s",
    "budget.dns_calls_per_reservation",
    "budget.reservations_per_label_per_day",
    "budget.trial_per_ip_per_window",
    "budget.trial_per_email_domain_per_window",
    "budget.trial_per_mailbox_per_window",
    "budget.lapsed_lift_after_s",
    "budget.abandons_per_label_per_window",
    "monitoring.lapsed_held_alert",
    "monitoring.jwks_age_alert_s",
    "monitoring.authorize_window_s",
    "monitoring.authorize_fail_alert_pct",
    "monitoring.authorize_fail_min_calls",
    "monitoring.criteria_min_coverage_pct",
    "migration.connected_now_s",
    "migration.migrate_floor_pct",
    "migration.lend_horizon_s",
    "migration.ineligible_hold_s",
    "migration.retire.min_days_since_ready",
    "migration.retire.sustain_days",
    "migration.retire.node_availability_permille_min",
    "migration.retire.authorize_failure_pct_max",
    "migration.retire.migrated_pct_min",
    "migration.retire.open_kill_events_max",
    "dns_failover.remove_after_failures",
    "dns_failover.restore_after_successes",
    "dns_failover.min_change_interval_s",
    "concierge.turns_per_session",
    "concierge.mutations_per_session"
  ],

  "protocol": {
    "version": 2,
    "alpn": "all-tunnel/2",
    "line_max_bytes": 8192,
    "open_line_max_bytes": 192,
    "statement_line_max_bytes": 65552,
    "jwt_max_bytes": 4096,
    "first_line_timeout_s": 10,
    "attach_timeout_s": 10,
    "stream_id_bytes": 16,
    "attach_secret_bytes": 32,
    "nonce_bytes": 16,
    "hint_max_addresses": 16,
    "proof_htm": "GET",
    "proof_htu_path": "/all-tunnel/2",
    "node_assertion_header": "x-all-node-assertion",
    "source_classes": ["openai", "hint", "anon"],
    "close_reasons": ["replaced", "revoked", "expired", "released", "killed", "paused", "drain", "idle", "protocol", "shutdown"],
    "error_codes": [
      "bad_hello", "bad_command", "unsupported_version", "bad_proof", "auth", "clock_skew", "unknown_stream", "bad_attach",
      "license_inactive", "device_revoked", "paused", "busy", "control_unavailable", "line_too_long"
    ]
  },

  "timing": {
    "ping_interval_s": 20,
    "dead_peer_s": 45,
    "stream_idle_s": 1800,
    "stream_max_age_s": 14400,
    "half_close_s": 30,
    "backoff_min_s": 1,
    "backoff_max_s": 60,
    "renew_before_valid_until_s": 300,
    "drain_quiet_s": 1200,
    "feed_poll_s": 15,
    "feed_apply_deadline_s": 20,
    "reconnect_after_wake_s": 5
  },

  "authorization": {
    "valid_until_paid_s": 14400,
    "valid_until_trial_s": 900,
    "valid_until_gated_s": 900,
    "grace_paid_s": 900,
    "authorize_max_concurrent": 50,
    "session_ttl_s": 300,
    "proof_ttl_s": 60,
    "node_assertion_ttl_s": 60,
    "node_skew_s": 5,
    "node_skew_max_s": 30,
    "access_ttl_paid_s": 14400,
    "access_ttl_trial_s": 600,
    "access_ttl_paywall_s": 600,
    "access_future_slack_s": 60,
    "stripe_status_cache_s": 120,
    "last_seen_write_interval_s": 300
  },

  "gated": {
    "bytes_per_day": 10485760,
    "streams_per_day": 200,
    "cutoff_days": 14
  },

  "license": {
    "revoked_notice_days": 7
  },

  "identity": {
    "issuer": "https://api.all-mcp.fyi",
    "aud_tunnel": "all-tunnel",
    "aud_access": "all-device-access",
    "aud_node_assertion": "all-tunnel-control",
    "label_length": 20,
    "label_alphabet": "abcdefghijklmnopqrstuvwxyz234567",
    "label_regex": "^[a-z2-7]{20}$",
    "fqdn_regex": "^[a-z2-7]{20}\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
    "fqdn_max_length": 253,
    "tombstone_idle_months": 12,
    "device_id_regex": "^[a-f0-9]{32}$",
    "stream_id_regex": "^[0-9a-f]{32}$",
    "attach_secret_regex": "^[A-Za-z0-9_-]{43}$",
    "nonce_regex": "^[A-Za-z0-9_-]{22,64}$",
    "jti_regex": "^[A-Za-z0-9_-]{16,128}$",
    "kid_regex": "^[A-Za-z0-9._-]{1,128}$"
  },

  "jwks": {
    "cache_s": 300,
    "max_keys": 16,
    "stale_fail_closed_s": 1800
  },

  "node_limits": {
    "client_hello_deadline_s": 5,
    "per_ip_concurrent": 16,
    "per_ip_new_per_s": 10,
    "ipv6_prefix_bits": 64,
    "label_streams_max": 64,
    "label_anon_slice": 16,
