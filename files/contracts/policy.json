    "openai_prefix_max": 2048,
    "openai_prefix_min_v4_bits": 16,
    "openai_prefix_min_v6_bits": 32,
    "openai_prefix_body_max_bytes": 1048576,
    "openai_per_ip_factor": 8,
    "device_per_ip_factor": 8,
    "ip_table_max": 65536,
    "unknown_sni_per_ip": 20,
    "unknown_sni_window_s": 60,
    "unknown_sni_ban_s": 600,
    "label_new_per_s": 20,
    "label_new_burst": 32,
    "hint_addresses_per_label": 64,
    "tcp_keepalive_s": 30,
    "max_unauthenticated_control": 256
  },

  "terminator": {
    "tls_handshake_s": 10,
    "request_head_s": 10,
    "request_head_max_bytes": 16384,
    "max_streams": 64,
    "endpoint_budgets": {
      "register": {"per_ip_per_min": 20},
      "authorize": {"per_ip_per_min": 60},
      "token": {"per_ip_per_min": 120},
      "pair": {"per_ip_per_min": 30},
      "mcp_anonymous": {"per_ip_per_min": 60}
    },
    "tls_min_version": "TLSv1.3",
    "tls_alpn": "http/1.1"
  },

  "surface": {
    "body_max_bytes": 16777216,
    "headers_max": 64,
    "header_value_max_bytes": 32768,
    "keep_alive_s": 75,
    "limiter_lru_max": 4096,
    "never_authorized_client_evict_hours": 24,
    "identity_path": "/__all/surface/v1/proof",
    "identity_challenge_header": "x-all-challenge",
    "identity_mac_header": "x-all-challenge-mac",
    "identity_proof_header": "x-all-surface-proof"
  },

  "pairing": {
    "window_s": 600,
    "code_ttl_e2e_s": 600,
    "code_ttl_local_s": 86400,
    "max_codes_local": 16,
    "bad_codes_burn": 5
  },

  "certificates": {
    "profile": "tlsserver",
    "profile_fallback": "classic",
    "profile_days": 45,
    "renew_backstop_divisor": 3,
    "ari_checks_per_day": 2,
    "min_attempt_gap_s": 21600,
    "max_issuances_per_day": 2,
    "txt_ttl_s": 60,
    "txt_value_length": 43,
    "ct_check_interval_s": 86400,
    "ct_degraded_after_s": 259200,
    "wait_after_install_s": 300
