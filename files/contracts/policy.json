    "tool_rounds_per_turn": 6,
    "mutations_per_session": 8,
    "history_messages_max": 16,
    "user_chars_max": 1400,
    "assistant_chars_max": 6000,
    "history_chars_max": 24000,
    "output_tokens_max": 1024,
    "model_deadline_s": 25,
    "audit_retention_days": 400,
    "refund": {
      "monthly_window_h": 72,
      "lifetime_window_days": 5,
      "max_actions_in_window": 100,
      "confirm_ttl_s": 600
    }
  },

  "enums": {
