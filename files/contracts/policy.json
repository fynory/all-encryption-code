    "first_issuances_total": 40,
    "classes": {"paid": 20, "trial": 12, "flex": 8},
    "borrow_only_unreserved_hours": 24,
    "per_label_per_window": 3,
    "per_license_per_day": 2,
    "reservation_ttl_s": 900,
    "alert_pct": 70,
    "borrow_from": {"paid": ["flex", "trial"], "trial": ["flex"], "flex": ["trial"]},
