  "dns": {
    "a_record_ttl_s": 60,
    "devices_caa": ["0 issue \"letsencrypt.org; validationmethods=dns-01\"", "0 issuewild \";\""],
    "node_caa": ["0 issue \"letsencrypt.org\""]
