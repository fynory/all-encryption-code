{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://all-mcp.fyi/contracts/v2/jwks.schema.json",
  "title": "The control plane's published keys (GET /.well-known/device-jwks.json, 1.1 shape). The node pins the issuer, caches 300 s, reloads on an unknown kid, accepts at most 16 keys and fails closed after 30 minutes without a refresh (policy.jwks).",
  "type": "object",
  "required": ["keys"],
  "additionalProperties": false,
  "properties": {
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["kty", "crv", "x", "kid", "alg", "use", "key_ops"],
        "additionalProperties": false,
        "properties": {
          "kty": {"const": "OKP"},
          "crv": {"const": "Ed25519"},
          "x": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
          "kid": {"$ref": "common.schema.json#/$defs/kid"},
          "alg": {"const": "EdDSA"},
          "use": {"const": "sig"},
          "key_ops": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "verify"}}
        }
      }
    }
  }
}
